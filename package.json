{
  "name": "leetdock",
  "displayName": "LeetDock",
  "description": "A focused LeetDock problem-solving workflow for Visual Studio Code.",
  "icon": "media/leetdock.png",
  "version": "0.1.0",
  "publisher": "cooronx",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cooronx/leetdock.git"
  },
  "bugs": {
    "url": "https://github.com/cooronx/leetdock/issues"
  },
  "homepage": "https://github.com/cooronx/leetdock#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "leetdock",
    "algorithm",
    "coding"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "colors": [
      {
        "id": "leetdock.streakFlame",
        "description": "Color of the daily challenge streak flame.",
        "defaults": {
          "dark": "#FF7043",
          "light": "#D84315",
          "highContrast": "#FFAB91",
          "highContrastLight": "#BF360C"
        }
      }
    ],
    "commands": [
      {
        "command": "leetdock.signIn",
        "title": "Sign In",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.signOut",
        "title": "Sign Out",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.openProblem",
        "title": "Open Problem",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.searchProblem",
        "title": "Search Problem",
        "category": "LeetDock",
        "icon": "$(search)"
      },
      {
        "command": "leetdock.refreshProblem",
        "title": "Refresh Problem",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.openCode",
        "title": "Open Code",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.switchLanguage",
        "title": "Switch Language",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.debugSolution",
        "title": "调试/Debug",
        "category": "LeetDock",
        "enablement": "resourceFilename == solution.cpp"
      },
      {
        "command": "leetdock.testSolution",
        "title": "Test Solution",
        "category": "LeetDock",
        "enablement": "resourceFilename =~ /^solution\\.(cpp|rs|py|java|ts)$/"
      },
      {
        "command": "leetdock.submitSolution",
        "title": "Submit Solution",
        "category": "LeetDock",
        "enablement": "resourceFilename =~ /^solution\\.(cpp|rs|py|java|ts)$/"
      },
      {
        "command": "leetdock.refreshProblemList",
        "title": "Refresh LeetDock Data",
        "category": "LeetDock",
        "icon": "$(refresh)"
      },
      {
        "command": "leetdock.refreshDailyChallenge",
        "title": "Refresh Daily Challenge",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.refreshMyProblemLists",
        "title": "Refresh My Problem Lists",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.searchTag",
        "title": "Search Tag",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.refreshTags",
        "title": "Refresh Tags",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.refreshTag",
        "title": "Refresh Tag Questions",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.loadMoreTag",
        "title": "Load More Tag Questions",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.searchCompany",
        "title": "Search Company",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.refreshCompanies",
        "title": "Refresh Companies",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.refreshCompany",
        "title": "Refresh Company Questions",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.loadMoreCompany",
        "title": "Load More Company Questions",
        "category": "LeetDock"
      },
      {
        "command": "leetdock.clearCache",
        "title": "Clear Cache",
        "category": "LeetDock",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetdock",
          "title": "LeetDock",
          "icon": "media/leetdock.svg"
        }
      ]
    },
    "views": {
      "leetdock": [
        {
          "id": "leetdock.explorer",
          "name": "LeetDock"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "leetdock.searchProblem",
          "when": "view == leetdock.explorer",
          "group": "navigation@1"
        },
        {
          "command": "leetdock.refreshProblemList",
          "when": "view == leetdock.explorer",
          "group": "navigation@2"
        },
        {
          "command": "leetdock.clearCache",
          "when": "view == leetdock.explorer",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "leetdock.debugSolution",
          "when": "resourceFilename == solution.cpp",
          "group": "leetdock@1"
        },
        {
          "command": "leetdock.testSolution",
          "when": "resourceFilename =~ /^solution\\.(cpp|rs|py|java|ts)$/",
          "group": "leetdock@2"
        },
        {
          "command": "leetdock.submitSolution",
          "when": "resourceFilename =~ /^solution\\.(cpp|rs|py|java|ts)$/",
          "group": "leetdock@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "leetdock.solutionActions",
          "when": "resourceFilename =~ /^solution\\.(cpp|rs|py|java|ts)$/",
          "group": "navigation@10"
        }
      ],
      "leetdock.solutionActions": [
        {
          "command": "leetdock.debugSolution",
          "when": "resourceFilename == solution.cpp",
          "group": "leetdock@1"
        },
        {
          "command": "leetdock.testSolution",
          "group": "leetdock@2"
        },
        {
          "command": "leetdock.submitSolution",
          "group": "leetdock@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "leetdock.solutionActions",
        "label": "LeetDock"
      }
    ],
    "configuration": {
      "title": "LeetDock",
      "properties": {
        "leetdock.defaultLanguage": {
          "type": "string",
          "enum": [
            "cpp",
            "rust",
            "python",
            "java",
            "typescript"
          ],
          "enumDescriptions": [
            "C++",
            "Rust",
            "Python 3",
            "Java",
            "TypeScript"
          ],
          "description": "生成 LeetDock 代码文件时使用的默认语言。",
          "scope": "window"
        },
        "leetdock.debug.cpp.compilerPath": {
          "type": "string",
          "default": "g++",
          "description": "本地调试 C++ solution.cpp 时使用的 g++ 可执行文件或绝对路径。",
          "scope": "resource"
        },
        "leetdock.debug.cpp.debuggerPath": {
          "type": "string",
          "default": "gdb",
          "description": "本地调试 C++ solution.cpp 时使用的 gdb 可执行文件或绝对路径。",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "check": "npm run compile && npm run check:extension-host && npm run check:solution-support && npm run check:debug-support && npm run check:problem-renderer && npm run check:daily-challenge && npm run check:problem-lists && npm run check:tag-library && npm run check:company-library",
    "check:extension-host": "node scripts/check-extension-host.cjs",
    "check:solution-support": "node scripts/check-solution-support.cjs",
    "check:debug-support": "node scripts/check-debug-support.cjs",
    "check:problem-renderer": "node scripts/check-problem-renderer.cjs",
    "check:daily-challenge": "node scripts/check-daily-challenge.cjs",
    "check:problem-lists": "node scripts/check-problem-lists.cjs",
    "check:tag-library": "node scripts/check-tag-library.cjs",
    "check:company-library": "node scripts/check-company-library.cjs",
    "watch": "tsc --watch -p ."
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "semantic-release-vsce",
        {
          "packageVsix": true
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "*.vsix",
              "label": "LeetDock VSIX"
            }
          ]
        }
      ]
    ]
  },
  "dependencies": {
    "katex": "^0.18.1",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "1.90.0",
    "semantic-release": "^25.0.9",
    "semantic-release-vsce": "^6.1.6",
    "typescript": "~5.9.3"
  }
}
